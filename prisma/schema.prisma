generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                String   @id @default(uuid())
  prefecture        String
  city              String
  schoolName        String
  address           String
  closestPoi        String
  lister            String
  phoneNumber       String
  additionalContact String
  zoningInfo        String
  landInfo          String
  structureInfo     String
  completionInfo    String
  facilityInfo      String
  buildingArea      Int
  floorArea         Int
  floorNum          Int
  recruitment       String
  conditions        String
  remarks           String
  images            Image[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([prefecture])
  @@index([city])
  @@index([floorArea])
}

model Image {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([schoolId, sortOrder])
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id            String         @id @default(uuid())
  username      String         @unique
  passwordHash  String
  role          AdminRole      @default(ADMIN)
  active        Boolean        @default(true)
  sessions      AdminSession[]
  apiKeys       ApiKey[]
  createdBlocks AccessBlock[]  @relation("BlockCreator")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AdminSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String
  keyHash     String    @unique
  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
  @@index([revokedAt])
}

model AccessBlock {
  id               String    @id @default(uuid())
  ipAddress        String?
  userAgentContains String?
  reason           String?
  active           Boolean   @default(true)
  createdById      String?
  createdBy        AdminUser? @relation("BlockCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ipAddress])
  @@index([active])
}
