# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mextdir?schema=public"

# Optional legacy API key for POST /api/schools and image uploads. Keep this server-only.
# Admin sessions and dashboard-created API keys are preferred.
ADMIN_API_KEY="replace-with-a-long-random-key"

# Umami analytics and session replay. Keep the website ID public but configurable.
UMAMI_URL="https://a.uwu.so"
UMAMI_WEBSITE_ID="8ff1d5ce-d5c1-4afd-8787-7ce7244e5d33"

# x402 agent/API payments. Direct development uses testnets; production Compose forces mainnet.
X402_ENABLED="false"
X402_ENVIRONMENT="development"
X402_FACILITATOR_URL="https://x402.org/facilitator"
X402_FACILITATOR_AUTH_TOKEN=""
X402_EVM_PAY_TO="0x959122793E6442837f177684CAf4CDDeBE27A606"
X402_SOLANA_PAY_TO="9MhMoXGiPfp3unKujAfcx1bRgNz63kTuWYvtcqVk5G4C"
X402_SOLANA_RPC_URL="https://api.devnet.solana.com"
# Production Compose defaults to Dexter's mainnet facilitator; override this if needed.
X402_PRODUCTION_FACILITATOR_URL="https://x402.dexter.cash"
# Never use x402.org/facilitator for production.

# Direct `pnpm dev` uses local storage. Both Compose stacks override this to MinIO S3 storage.
STORAGE_DRIVER="local"

# S3-compatible settings (used when STORAGE_DRIVER="s3").
# Direct host / dev Compose values:
# S3_ENDPOINT="http://localhost:9002"
# S3_REGION="us-east-1"
# S3_BUCKET="mextdir"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_PUBLIC_URL="http://localhost:9002/mextdir"
# S3_FORCE_PATH_STYLE="true"
# Main Compose uses http://minio:9000 internally and http://localhost:9000/mextdir publicly.

# Trust X-Forwarded-For only when the app is behind your own proxy.
TRUST_PROXY="false"

# Mistral OCR importer. Keep the API key server-side and never expose it to the browser.
MISTRAL_API_KEY=""
MISTRAL_OCR_MODEL="mistral-ocr-4-0"
MISTRAL_OCR_TIMEOUT_MS="300000"
MEXT_IMPORT_SECRET="replace-with-a-long-random-import-secret"
MEXT_IMPORT_INTERVAL_SECONDS="86400"
MEXT_IMPORT_RUN_ON_START="true"

# Start in read-only demo mode. Set to false after PostgreSQL is running.
DEMO_MODE="true"
