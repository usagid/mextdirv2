# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mextdir?schema=public"

# Required for POST /api/schools and image uploads. Keep this server-only.
ADMIN_API_KEY="replace-with-a-long-random-key"

# local is implemented for development. See README for S3-compatible storage notes.
STORAGE_DRIVER="local"

# Start in read-only demo mode. Set to false after PostgreSQL is running.
DEMO_MODE="true"
